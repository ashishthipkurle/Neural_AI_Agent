{
    "name": "neural-ai-agent",
    "version": "1.0.0",
    "description": "AI Agent Desktop Application - Local Jarvis-class AI",
    "main": "./out/main/index.js",
    "author": "Neural AI Team",
    "homepage": "https://electron-vite.org",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
        "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
        "start": "electron-vite preview",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-toast": "^1.2.6",
        "@radix-ui/react-tooltip": "^1.1.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.0.6",
        "lucide-react": "^0.462.0",
        "node-pty": "^1.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.22.3",
        "source-map-support": "^0.5.21",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.160.1",
        "ws": "^8.19.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0"
    },
    "devDependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@types/node": "^18.19.69",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3",
        "electron-vite": "^2.3.0",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^5.4.1"
    },
    "build": {
        "appId": "com.neural-ai-agent.app",
        "productName": "Neural AI Agent",
        "win": {
            "target": [
                "nsis"
            ]
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "resources/**/*",
            "package.json"
        ]
    }
}
